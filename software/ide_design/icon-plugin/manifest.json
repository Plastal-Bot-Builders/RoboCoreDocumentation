{
  "name": "RoboCore App Icon Builder",
  "id": "robocore-app-icon-builder",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": [
    "figma"
  ],
  "documentAccess": "dynamic-page",
  "networkAccess": {
    "allowedDomains": [
      "none"
    ],
    "devAllowedDomains": [
      "http://localhost:8765"
    ],
    "reasoning": "Development only: sends PNG previews of the generated icon page to a local review server."
  },
  "menu": [
    {
      "name": "Build all rounds",
      "command": "icon"
    },
    {
      "separator": true
    },
    {
      "name": "Round 2 · Forward Gear only",
      "command": "forward"
    },
    {
      "name": "Round 3 · Geared Ring only",
      "command": "orbit"
    }
  ]
}
