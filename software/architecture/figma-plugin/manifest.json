{
  "name": "RoboCore Architecture Builder",
  "id": "robocore-architecture-builder",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": [
    "figma"
  ],
  "documentAccess": "dynamic-page",
  "networkAccess": {
    "allowedDomains": [
      "none"
    ],
    "devAllowedDomains": [
      "http://localhost:8765"
    ],
    "reasoning": "Development only: sends PNG previews of the generated diagrams to a local review server."
  },
  "menu": [
    {
      "name": "Build into empty file",
      "command": "build"
    },
    {
      "separator": true
    },
    {
      "name": "Rebuild — replace the generated pages",
      "command": "rebuild"
    }
  ]
}
