	(text "Four hobby-servo headers (signal, +, -) as on the XRP. Power is VMOT" (exclude_from_sim no) (at 17.78 24.64 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left)) (uuid "39c3bcdf-5145-406b-942f-65cd98ca8815"))
	(text "(5.5 V); C401/C402 are local bulk storage." (exclude_from_sim no) (at 17.78 27.64 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left)) (uuid "188694c8-cf69-4b0b-83f9-cdbdd5a8caf8"))
